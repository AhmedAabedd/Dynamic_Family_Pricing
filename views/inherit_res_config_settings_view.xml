<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_inherit_res_config_settings_promotion_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.promotion</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//setting[@id='show_margins']" position="after">
                <setting id="show_family_pricing" help="Activate or deactivate the family pricing system">
                    <field name="family_pricing_active"/>
                </setting>
            </xpath>
            
        </field>
    </record>

</odoo>