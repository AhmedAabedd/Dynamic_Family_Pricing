<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_inherit_res_config_settings_promotion_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.promotion</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@id='show_margins']" position="after">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="family_pricing_active"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="family_pricing_active"/>
                        <div class="text-muted">
                            Enable or disable the Family pricing system for sales orders
                        </div>
                    </div>
                </div>
            </xpath>
            
        </field>
    </record>

</odoo>
