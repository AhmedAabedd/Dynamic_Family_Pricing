        <field name="model">product.category</field>
        <field name="inherit_id" ref="stock.product_category_form_view_inherit"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='packaging_reserve_method']" position="after">
                <field name="seuil"/>
            </xpath>
            
        </field>
    </record>

</odoo>