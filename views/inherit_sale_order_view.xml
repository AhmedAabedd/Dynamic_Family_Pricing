<odoo>

    <record id="view_inherit_sale_order_pricing_form" model="ir.ui.view">
        <field name="name">sale.order.pricing.inherited</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='note_group']" position="before">
                <div style="position: absolute; right: 210px;">
                    <button type="object" name="apply_family_pricing" string="Promotion" class="btn-primary"/>
                </div>
            </xpath>

            <xpath expr="//field[@name='product_template_id']" position="after">
                <field name="family_id" string="Family" readonly="1"/>
                <field name="line_unit" readonly="1"/>
            </xpath>
            
            
        </field>
    </record>

</odoo>